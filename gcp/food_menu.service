[Unit]
Description=Gunicorn daemon for Online Food Menu System
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/food-menu
EnvironmentFile=-/var/www/food-menu/.env
ExecStart=/var/www/food-menu/venv/bin/gunicorn \
          --access-logfile /var/log/gunicorn/food_menu_access.log \
          --error-logfile /var/log/gunicorn/food_menu_error.log \
          --workers 3 \
          --bind 127.0.0.1:8000 \
          core.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
