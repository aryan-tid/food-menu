# ==============================================================================
# Environment Configuration for Online Food Menu System
# Copy this to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Debug & Security (Set DEBUG=True for local/ngrok, False for GCP VM Production)
# ------------------------------------------------------------------------------
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-&qd0c#6#_=l+r4an(eb5)l*phq&&v4m01*yktikdyz!v#wa(4d

# ------------------------------------------------------------------------------
# 2. Hostnames & Domains (Comma-separated)
# In local development with ngrok, include your ngrok URL or .ngrok-free.app
# In production on GCP, set your external VM IP (e.g. 34.xxx.xxx.xxx) or domain
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=127.0.0.1,localhost,.ngrok-free.app,.ngrok.io,YOUR_NGROK_OR_GCP_IP

# ------------------------------------------------------------------------------
# 3. CSRF Trusted Origins (Required for POST requests, cart AJAX, & login)
# Note: Always include the scheme (https:// for ngrok, http:// for local / raw IP)
# ------------------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.io,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 4. Firebase Authentication (Google Sign-In)
# Copy from Firebase Console -> Project Settings -> General -> Web App Config
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-app
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/serviceAccountKey.json

# ------------------------------------------------------------------------------
# 5. Database Configuration (Defaults to SQLite if omitted)
# ------------------------------------------------------------------------------
# Option A: PostgreSQL on GCP Compute Engine VM / Localhost
# DB_ENGINE=postgresql
# DB_NAME=food_menu_db
# DB_USER=food_user
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Option B: Google Cloud SQL for PostgreSQL (UNIX domain socket)
# DB_ENGINE=postgresql
# DB_NAME=food_menu_db
# DB_USER=food_user
# DB_PASSWORD=your_secure_db_password
# DB_HOST=/cloudsql/YOUR_PROJECT_ID:YOUR_REGION:YOUR_INSTANCE_NAME

# Option C: Direct Connection URL
# DATABASE_URL=postgres://food_user:your_secure_db_password@localhost:5432/food_menu_db
